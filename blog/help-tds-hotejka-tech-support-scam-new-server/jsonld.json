  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is Help TDS?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A traffic distribution system that sorts web visitors from hacked sites, spam, and parked domains and sends qualifying U.S. users to fake Microsoft lock screens with toll-free numbers for call centers. Infoblox says it has been active since at least April 2017."
        }
      },
      {
        "@type": "Question",
        "name": "Who runs Help TDS?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Infoblox assesses that Hotejka, a small Russian-language affiliate program, operates it. No individual has been publicly identified."
        }
      },
      {
        "@type": "Question",
        "name": "Is Hotejka the same as ROI777?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Infoblox assesses that it is. It says historical DNS records, long use of the same advertising platforms, and consistent command-and-control mechanisms give it a high degree of confidence that the two are one and the same. Its clearest example is 162.244.35.33, an address that hosted roi777[.]com until mid-March 2022 and, from early 2020, carried hotejka[.]com as its reverse-DNS name. ROI777 was named in Guardicore Labs’ June 2018 report on Operation Prowli as a buyer of hijacked web traffic."
        }
      },
      {
        "@type": "Question",
        "name": "What was in the 2018 ROI777 leak?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "On March 13, 2018, an anonymous Pastebin user posted tables purportedly taken from ROI777 servers: eleven Telegram accounts, eleven logins for a Keitaro traffic-routing server, 333 campaign records, most labeled with email addresses, and two database account lists. Five campaigns carried call-center numbers for five countries, and four were set to a “tech_support” action. The records have not been authenticated."
        }
      },
      {
        "@type": "Question",
        "name": "Is Help TDS still active after the Infoblox report?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. On October 21, 2026, its Telegram channel was still announcing new Cloudflare Pages addresses, and its redirect domain, hotcname[.]help, resolved to a Frankfurt server that was not on Infoblox’s October 15 indicator list."
        }
      },
      {
        "@type": "Question",
        "name": "What happens if you call the number on the pop-up?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "In Infoblox’s test call, a man claiming to be Microsoft Technical Support removed the lock and told the caller to download the UltraViewer remote-access tool, which would give him full control of the computer."
        }
      }
    ]
  }
