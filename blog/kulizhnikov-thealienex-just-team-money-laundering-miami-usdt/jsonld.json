  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Who is Pavel Alekseyevich Kulizhnikov?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "He is the lead defendant in a federal criminal complaint filed in the Eastern District of Virginia (case 1:26-MJ-407) and unsealed on October 21, 2026, in the Southern District of Florida (case 0:26-mj-06603-PAB). A DEA affidavit describes him as a Miami-area cryptocurrency reseller and broker affiliated with the “JUST Team” of a Russian money laundering organization. As of October 23, 2026, he has not been convicted."
        }
      },
      {
        "@type": "Question",
        "name": "What is he charged with?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The complaint charges him and a redacted co-defendant with money laundering conspiracy under 18 U.S.C. § 1956(h), with concealment and sting objects. A second redacted defendant is charged with conspiracy to conduct an unlicensed money transmitting business under 18 U.S.C. §§ 371 and 1960."
        }
      },
      {
        "@type": "Question",
        "name": "What is TheAlienEx?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "TheAlienEx is a public Telegram channel, t.me/TheAlienEx, that advertises USDT-to-dollar exchange, ruble-to-dollar cash exchange in Moscow and Miami, and invoice payments. It directs customers to the manager account @TheAlienEx_manager. The DEA affidavit says @TheAlienEx_manager is one of Kulizhnikov’s Telegram usernames. The affidavit does not name the channel itself."
        }
      },
      {
        "@type": "Question",
        "name": "Where does the $50 million-a-day figure come from?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "It is a confidential source’s estimate. According to the affidavit, a source identified as CS7 estimated that the JUST Team launders approximately $50 million per day. The figure has not been tested in court."
        }
      }
    ]
  }
